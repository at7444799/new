# Frontend variables from your old app can stay, but DO NOT put secret keys in VITE_ variables for production.
VITE_APP_NAME=CreatorOS AI
VITE_APP_URL=http://localhost:5173

# GitHub Actions secrets needed by scripts/auto-post.js
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_permanent_page_token
IG_USER_ID=your_instagram_business_or_creator_user_id

NVIDIA_API_KEY=nvapi-your-key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional cloud image manifest. Must be public raw JSON.
# Format: {"images":["https://example.com/photo1.jpg","https://example.com/photo2.png"]}
CLOUD_IMAGE_MANIFEST_URL=

# After successful posting: delete or move
POST_USE_ACTION=delete

# Future image-to-video hook. Keep none until you configure a provider adapter.
VIDEO_GENERATION_PROVIDER=none
VIDEO_GENERATION_API_KEY=
